[Unit]
Description=JustSo EasySRT Sender
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=easysrt
Group=easysrt
WorkingDirectory=/opt/justso-easysrt/backend
EnvironmentFile=-/etc/justso-easysrt/easysrt.env
ExecStart=/usr/bin/python3 -I /usr/local/lib/justso-easysrt/sender-supervisor.py --runtime /opt/justso-easysrt/backend/data/applied_sender.json --status /opt/justso-easysrt/backend/data/sender_status.json
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
